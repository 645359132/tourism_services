APP_NAME=Smart Tourism Service
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./data/tourism.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://tourism:tourism@localhost:5432/tourism
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
# Comma-separated proxy IP/CIDR allowlist. Empty means X-Forwarded-For is ignored.
TRUSTED_PROXY_NETWORKS=
SECURITY_HEADERS_ENABLED=true
LOG_LEVEL=INFO
LOG_JSON=false
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=smart-tourism-service
JWT_AUDIENCE=smart-tourism-client
# Explicitly opt in only for disposable local demo environments.
ENABLE_DEMO_ACCOUNTS=false
TICKET_ORDER_RESERVATION_MINUTES=15
TICKET_QUOTE_TTL_SECONDS=300
TICKET_QR_TTL_SECONDS=300
TICKET_REFUND_CUTOFF_HOURS=24
CROWD_PUBLISH_INTERVAL_SECONDS=30
RESERVATION_HOLD_MINUTES=15
RESERVATION_WALKING_BUFFER_MINUTES=10
QUEUE_PUBLISH_INTERVAL_SECONDS=15
WS_TICKET_TTL_SECONDS=60
FASTPASS_VALID_MINUTES=60
SHOP_ORDER_RESERVATION_MINUTES=15
REDIS_URL=redis://localhost:6379/0
REDIS_COORDINATION_ENABLED=false
REDIS_REQUIRED=false
REDIS_KEY_PREFIX=tourism
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_CACHE_ENABLED=true
REDIS_PUBSUB_ENABLED=true
REDIS_RATE_LIMIT_ENABLED=true
REDIS_TICKET_ENABLED=true
REDIS_LOCK_ENABLED=true
REFERENCE_CACHE_TTL_SECONDS=60
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MUTATION_REQUESTS=120
RATE_LIMIT_AUTH_REQUESTS=30
RATE_LIMIT_WS_TICKET_REQUESTS=30
COORDINATION_CLAIM_TTL_SECONDS=30
COORDINATION_LOCK_WAIT_SECONDS=2
