APP_NAME=Smart Tourism Service
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./data/tourism.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://tourism:tourism@localhost:5432/tourism
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true
LOG_LEVEL=INFO
LOG_JSON=false
