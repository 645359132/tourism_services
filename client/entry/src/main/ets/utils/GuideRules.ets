import {
  Attraction,
  CrowdEnvelope,
  CrowdItem,
  CrowdLevel,
  GuideMapNode,
  Itinerary,
  ItineraryGenerateRequest,
  ItineraryItem
} from '../models/GuideModels';

export class GuideRuleResult {
  valid: boolean;
  message: string;

  constructor(valid: boolean, message: string) {
    this.valid = valid;
    this.message = message;
  }
}

export class CrowdEnvelopeParseResult {
  valid: boolean;
  message: string;
  envelope: CrowdEnvelope | null;

  constructor(valid: boolean, message: string, envelope: CrowdEnvelope | null) {
    this.valid = valid;
    this.message = message;
    this.envelope = envelope;
  }
}

export class TimelineConflictDisplay {
  conflicted: boolean;
  firstItemId: string;
  secondItemId: string;
  message: string;

  constructor(conflicted: boolean, firstItemId: string, secondItemId: string, message: string) {
    this.conflicted = conflicted;
    this.firstItemId = firstItemId;
    this.secondItemId = secondItemId;
    this.message = message;
  }
}

export class ReplanAssessment {
  accepted: boolean;
  message: string;

  constructor(accepted: boolean, message: string) {
    this.accepted = accepted;
    this.message = message;
  }
}

export function visibleItineraryItems(items: ItineraryItem[]): ItineraryItem[] {
  const visible: ItineraryItem[] = [];
  for (let index: number = 0; index < items.length; index++) {
    // 旧版曾把普通入园票保存成独占 COMMITMENT。它只是准入窗口，离线缓存也应隐藏。
    // 历史客户端契约没有 ref_type；现有版本产生过的 COMMITMENT 仅有普通门票窗口。
    if (items[index].kind === 'COMMITMENT') {
      continue;
    }
    visible.push(items[index]);
  }
  return visible;
}

export function itineraryItemRenderKey(item: ItineraryItem): string {
  return `${item.id}:${item.kind}:${item.ref_id}:${item.title}:${item.start_at}:${item.end_at}:` +
    `${item.locked}:${item.crowd_level}:${item.walk_minutes}:${item.explanation.join('|')}`;
}

export function plannedRouteStepLabel(routeNodeIds: string[], nodeId: string): string {
  const index: number = routeNodeIds.indexOf(nodeId);
  if (index < 0) {
    return '';
  }
  if (routeNodeIds.length === 1) {
    return '起终';
  }
  if (index === 0) {
    return '起';
  }
  if (index === routeNodeIds.length - 1) {
    return '终';
  }
  return `${index + 1}`;
}

export function plannedRoutePathText(nodes: GuideMapNode[], routeNodeIds: string[]): string {
  const names: string[] = [];
  for (let routeIndex: number = 0; routeIndex < routeNodeIds.length; routeIndex++) {
    let name: string = '未知节点';
    for (let nodeIndex: number = 0; nodeIndex < nodes.length; nodeIndex++) {
      if (nodes[nodeIndex].id === routeNodeIds[routeIndex]) {
        name = nodes[nodeIndex].name;
        break;
      }
    }
    names.push(name);
  }
  return names.join(' → ');
}

export function itineraryKindLabel(kind: string): string {
  switch (kind) {
    case 'ATTRACTION':
      return '景点';
    case 'COMMITMENT':
      return '固定预约';
    case 'EXPERIENCE':
      return '体验';
    case 'DINING':
      return '餐饮';
    case 'STAY':
      return '住宿';
    case 'TRANSPORT':
      return '交通';
    case 'RESTAURANT':
      return '餐厅';
    default:
      return kind;
  }
}

export function itineraryCrowdLabel(level: string): string {
  switch (level) {
    case 'LOW':
      return '舒适';
    case 'MEDIUM':
      return '适中';
    case 'HIGH':
      return '拥挤';
    default:
      return level;
  }
}

export function itinerarySeverityLabel(severity: string): string {
  switch (severity) {
    case 'INFO':
      return '提示';
    case 'WARNING':
      return '警告';
    case 'ERROR':
      return '错误';
    case 'CRITICAL':
      return '严重';
    default:
      return severity;
  }
}

export function itineraryActionLabel(action: string): string {
  switch (action) {
    case 'START_AFTER_TICKET':
      return '调整至门票预约后';
    case 'SHIFT_ITEM':
      return '调整项目时间';
    case 'REMOVE_ITEM':
      return '移除项目';
    case 'REVIEW_MANDATORY':
      return '人工确认';
    default:
      return action;
  }
}

export function localizeItineraryText(value: string): string {
  switch (value) {
    case 'Generated by deterministic local rules; no AI provider is connected':
      return '由本地规则引擎生成，未连接外部智能模型';
    case 'Scores combine interests, simulated crowd, schematic distance, companions, fitness, and accessibility':
      return '评分综合兴趣、人流、步行距离、同行人群、体力和无障碍需求';
    case 'Locked paid-ticket commitment':
      return '已锁定的付费门票预约';
    case 'No eligible attraction fits the request':
      return '没有符合当前条件的可排期景点';
    case 'Origin and destination are the same schematic node':
      return '起点与终点位于同一示意节点';
    case 'Shortest deterministic path over the local schematic graph':
      return '采用本地示意地图中的最短路线';
    case 'No accessibility edge filter':
      return '未启用无障碍路线筛选';
    case 'Applied: wheelchair-safe edges':
      return '已筛选轮椅可通行路线';
    case 'Applied: stroller-safe edges':
      return '已筛选婴儿车可通行路线';
    case 'Applied: wheelchair-safe edges, stroller-safe edges':
      return '已筛选轮椅和婴儿车可通行路线';
    case 'Replanned from the latest persisted simulated crowd sequence':
      return '已根据最新保存的模拟人流数据重新规划';
    case 'Replanned by deterministic rules using simulated crowd data':
      return '已根据模拟人流数据通过本地规则重新规划';
    case 'Only unlocked items were eligible for movement':
      return '本次仅调整未锁定的行程项目';
    case 'A paid ticket commitment overlaps this itinerary item':
      return '付费门票预约与当前行程项目时间重叠';
    case 'Itinerary items overlap under half-open interval rules':
      return '行程项目时间重叠';
    case 'No schematic route connects consecutive items':
      return '连续行程项目之间没有可用的示意路线';
    case 'Move the unlocked item after the paid ticket commitment':
      return '将未锁定项目移至付费门票预约之后';
    case 'Move the later unlocked item after the earlier item and buffer':
      return '将较晚的未锁定项目移至前一项目及缓冲时间之后';
    case 'Move the earlier unlocked item before the locked commitment':
      return '将较早的未锁定项目移至锁定预约之前';
    case 'Both conflicting commitments are locked and require user review':
      return '两个冲突预约均已锁定，需要人工确认';
    case 'Remove or replace the unreachable unlocked item':
      return '移除或替换无法到达的未锁定项目';
    case 'Both unreachable commitments are locked and require review':
      return '两个无法衔接的预约均已锁定，需要人工确认';
    case 'Shift the later unlocked item for walking and buffer time':
      return '为步行和缓冲时间顺延较晚的未锁定项目';
    case 'Shift the earlier unlocked item before the locked commitment':
      return '将较早的未锁定项目提前至锁定预约之前';
    case 'Locked commitments lack walking buffer and require review':
      return '锁定预约之间缺少步行缓冲时间，需要人工确认';
    default:
      break;
  }
  let localized: string = value.replace(
    /^Interest matches: ([0-9]+) \(([+-][0-9]+)\)$/,
    '兴趣匹配 $1 项（$2）'
  );
  if (localized !== value) {
    return localized;
  }
  localized = value.replace(/^Schematic walk ([0-9]+) min \(([+-][0-9]+)\)$/,
    '示意步行 $1 分钟（$2）');
  if (localized !== value) {
    return localized;
  }
  localized = value.replace(/^Companion fit \(([+-][0-9]+)\)$/, '同行人群适配（$1）');
  if (localized !== value) {
    return localized;
  }
  localized = value.replace(/^Fitness fit \(([+-][0-9]+)\)$/, '体力适配（$1）');
  if (localized !== value) {
    return localized;
  }
  localized = value.replace(/^Wheelchair accessibility \(([+-][0-9]+)\)$/, '轮椅无障碍适配（$1）');
  if (localized !== value) {
    return localized;
  }
  const crowdPrefix: string = 'Simulated crowd ';
  if (value.startsWith(crowdPrefix)) {
    const detail: string = value.substring(crowdPrefix.length);
    const firstSpace: number = detail.indexOf(' ');
    if (firstSpace > 0) {
      const level: string = detail.substring(0, firstSpace);
      const score: string = detail.substring(firstSpace + 1).replace(/^\(([+-][0-9]+)\)$/, '（$1）');
      return `模拟人流：${itineraryCrowdLabel(level)}${score}`;
    }
  }
  const noRouteSuffix: string = ': no route from previous stop';
  if (value.endsWith(noRouteSuffix)) {
    return `${value.substring(0, value.length - noRouteSuffix.length)}：无法从上一站到达`;
  }
  const missingDataSuffix: string = ': missing graph or simulated crowd data';
  if (value.endsWith(missingDataSuffix)) {
    return `${value.substring(0, value.length - missingDataSuffix.length)}：缺少示意地图或模拟人流数据`;
  }
  const wheelchairUnavailableSuffix: string = ': wheelchair accessibility unavailable';
  if (value.endsWith(wheelchairUnavailableSuffix)) {
    return `${value.substring(0, value.length - wheelchairUnavailableSuffix.length)}：暂不支持轮椅无障碍通行`;
  }
  const noAccessibleRouteSuffix: string = ': no accessible schematic route';
  if (value.endsWith(noAccessibleRouteSuffix)) {
    return `${value.substring(0, value.length - noAccessibleRouteSuffix.length)}：没有可用的无障碍示意路线`;
  }
  const noFitSuffix: string = ': does not fit the requested duration';
  if (value.endsWith(noFitSuffix)) {
    return `${value.substring(0, value.length - noFitSuffix.length)}：无法在指定游玩时长内排入`;
  }
  const returnPrefix: string = 'RETURN_LEG_EXCEEDS_WINDOW: ';
  const noReturnSuffix: string = ' has no return route';
  const returnExceedsSuffix: string = ' return exceeds duration';
  if (value.startsWith(returnPrefix) && value.endsWith(noReturnSuffix)) {
    return `${value.substring(returnPrefix.length, value.length - noReturnSuffix.length)}：没有可用返程路线`;
  }
  if (value.startsWith(returnPrefix) && value.endsWith(returnExceedsSuffix)) {
    return `${value.substring(returnPrefix.length, value.length - returnExceedsSuffix.length)}：返程时间超出游玩时长`;
  }
  localized = value.replace(
    /^Needs ([0-9]+) walking minutes plus ([0-9]+) buffer minutes$/,
    '需要 $1 分钟步行时间，另加 $2 分钟缓冲时间'
  );
  return localized;
}

export function localizeItineraryTexts(values: string[]): string[] {
  const localized: string[] = [];
  for (let index: number = 0; index < values.length; index++) {
    localized.push(localizeItineraryText(values[index]));
  }
  return localized;
}

export function classifyCrowdLevel(occupancyBps: number, waitMinutes: number): CrowdLevel {
  if (occupancyBps >= 7500 || waitMinutes >= 40) {
    return CrowdLevel.HIGH;
  }
  if (occupancyBps >= 4500 || waitMinutes >= 20) {
    return CrowdLevel.MEDIUM;
  }
  return CrowdLevel.LOW;
}

export function shouldAcceptCrowdSequence(currentSequence: number, incomingSequence: number): boolean {
  return incomingSequence > currentSequence;
}

export function parseCrowdEnvelope(payload: string): CrowdEnvelopeParseResult {
  if (payload.trim().length === 0) {
    return new CrowdEnvelopeParseResult(false, '人流消息为空', null);
  }
  try {
    const envelope: CrowdEnvelope = JSON.parse(payload) as CrowdEnvelope;
    if (envelope.id.length === 0 || envelope.type !== 'crowd.snapshot' || envelope.occurred_at.length === 0) {
      return new CrowdEnvelopeParseResult(false, '人流消息信封字段无效', null);
    }
    if (envelope.data.sequence < 0 || envelope.data.source !== 'simulated' || !envelope.data.is_demo ||
      envelope.data.items === undefined) {
      return new CrowdEnvelopeParseResult(false, '人流快照边界字段无效', null);
    }
    return new CrowdEnvelopeParseResult(true, '', envelope);
  } catch (error) {
    return new CrowdEnvelopeParseResult(false, '人流消息不是有效 JSON', null);
  }
}

export function validateItineraryGenerateInput(input: ItineraryGenerateRequest): GuideRuleResult {
  if (!/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(input.visit_date)) {
    return new GuideRuleResult(false, '游玩日期格式应为 YYYY-MM-DD');
  }
  if (!/^([01][0-9]|2[0-3]):[0-5][0-9]$/.test(input.start_time)) {
    return new GuideRuleResult(false, '开始时间格式应为 HH:mm');
  }
  if (!Number.isInteger(input.duration_minutes) || input.duration_minutes < 60 || input.duration_minutes > 720) {
    return new GuideRuleResult(false, '游玩时长应为 60 至 720 分钟');
  }
  if (input.interests.length === 0) {
    return new GuideRuleResult(false, '请至少选择一个兴趣');
  }
  const validCompanion: boolean = input.companion_type === 'solo' || input.companion_type === 'family' ||
    input.companion_type === 'friends' || input.companion_type === 'senior';
  if (!validCompanion) {
    return new GuideRuleResult(false, '同行类型无效');
  }
  const validFitness: boolean = input.fitness_level === 'low' || input.fitness_level === 'medium' ||
    input.fitness_level === 'high';
  if (!validFitness) {
    return new GuideRuleResult(false, '体力等级无效');
  }
  return new GuideRuleResult(true, '');
}

export function findTimelineConflict(items: ItineraryItem[]): TimelineConflictDisplay {
  const ordered: ItineraryItem[] = items.slice();
  ordered.sort((left: ItineraryItem, right: ItineraryItem): number => left.start_at.localeCompare(right.start_at));
  for (let index: number = 0; index < ordered.length - 1; index++) {
    const current: ItineraryItem = ordered[index];
    const next: ItineraryItem = ordered[index + 1];
    if (current.start_at < current.end_at && next.start_at < next.end_at && next.start_at < current.end_at) {
      return new TimelineConflictDisplay(true, current.id, next.id,
        `${current.title} 与 ${next.title} 的时间发生重叠`);
    }
  }
  return new TimelineConflictDisplay(false, '', '', '时间轴未发现直接重叠');
}

function findItineraryItem(items: ItineraryItem[], itemId: string, refId: string): ItineraryItem | null {
  for (let index: number = 0; index < items.length; index++) {
    if (items[index].id === itemId || (refId.length > 0 && items[index].ref_id === refId)) {
      return items[index];
    }
  }
  return null;
}

export function assessReplan(previous: Itinerary, updated: Itinerary): ReplanAssessment {
  if (updated.id !== previous.id || updated.revision <= previous.revision) {
    return new ReplanAssessment(false, '重排版本无效，已保留当前行程');
  }
  for (let index: number = 0; index < previous.items.length; index++) {
    const lockedItem: ItineraryItem = previous.items[index];
    if (!lockedItem.locked) {
      continue;
    }
    const updatedItem: ItineraryItem | null = findItineraryItem(updated.items, lockedItem.id, lockedItem.ref_id);
    if (updatedItem === null || updatedItem.start_at !== lockedItem.start_at || updatedItem.end_at !== lockedItem.end_at) {
      return new ReplanAssessment(false, `锁定预约“${lockedItem.title}”被移动，已拒绝本次重排`);
    }
  }
  return new ReplanAssessment(true, '已按最新模拟人流重排，锁定预约保持不变');
}

function crowdRank(level: CrowdLevel): number {
  if (level === CrowdLevel.HIGH) {
    return 3;
  }
  if (level === CrowdLevel.MEDIUM) {
    return 2;
  }
  return 1;
}

function attractionName(attractions: Attraction[], attractionId: string): string {
  for (let index: number = 0; index < attractions.length; index++) {
    if (attractions[index].id === attractionId) {
      return attractions[index].name;
    }
  }
  return '当前景点';
}

export function buildCrowdAlternative(attractions: Attraction[], crowdItems: CrowdItem[]): string {
  if (crowdItems.length < 2) {
    return '等待更多模拟人流数据后生成替代路线';
  }
  let busiest: CrowdItem = crowdItems[0];
  let quietest: CrowdItem = crowdItems[0];
  for (let index: number = 1; index < crowdItems.length; index++) {
    if (crowdRank(crowdItems[index].level) > crowdRank(busiest.level)) {
      busiest = crowdItems[index];
    }
    if (crowdRank(crowdItems[index].level) < crowdRank(quietest.level)) {
      quietest = crowdItems[index];
    }
  }
  if (busiest.attraction_id === quietest.attraction_id || busiest.level !== CrowdLevel.HIGH) {
    return '当前模拟人流较均衡，可按原路线游览';
  }
  return `${attractionName(attractions, busiest.attraction_id)}较拥挤，建议先游览` +
    `${attractionName(attractions, quietest.attraction_id)}（预计等待 ${quietest.wait_minutes} 分钟）`;
}
